# FYJ Channel Remote - Environment Configuration

# Server Settings
PORT=4000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=fyj_channel_remote_jwt_secret_key_2026_super_secure
# 32-character encryption key for AES-256-CBC token encryption
CYPHER_KEY=12345678901234567890123456789012

# Database Configuration
# For SQLite (Zero config, immediate local run):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (Docker):
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/remote_lab_db?schema=public"

# Apache Guacamole Daemon (guacd) Configuration
GUACD_HOST=127.0.0.1
GUACD_PORT=4822

# Network / Wake-on-LAN Settings
DEFAULT_BROADCAST_IP=255.255.255.255
WOL_PORT=9
HEARTBEAT_INTERVAL_MS=5000
